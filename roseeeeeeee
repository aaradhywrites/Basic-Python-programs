# =========================================================
# COLORS
# =========================================================

SKY_TOP = "#000000"
SKY_BOTTOM = "#000000"
GROUND = "#000000"
GROUND_LINE = "#111111"

STEM = "#2e5e2a"
STEM_LIGHT = "#5c9450"
LEAF = "#2e6b2e"
LEAF_LIGHT = "#57a34f"
LEAF_EDGE = "#1f4a20"

OUTER = "#7a0e26"
OUTER_EDGE = "#4d0616"
